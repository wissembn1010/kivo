# Copy this file to a protected deployment path named .env.production.
# Replace every angle-bracket placeholder before deployment. Never commit the real file.

# Public identity
DOMAIN="<DOMAIN>"
SITE_NAME="<DOMAIN>"
ADMIN_EMAIL="<ADMIN_EMAIL>"
SERVER_IP="<SERVER_IP>"
LETSENCRYPT_EMAIL="<ADMIN_EMAIL>"
SITES_RULE='Host(`<DOMAIN>`)'

# Immutable custom image
CUSTOM_IMAGE="<CONTAINER_REGISTRY>/<IMAGE_NAMESPACE>/creditflow"
CUSTOM_TAG="<RELEASE_TAG>"
PULL_POLICY="never"
RESTART_POLICY="unless-stopped"
FRAPPE_BRANCH="version-16"
CREDITFLOW_REPO_URL="<CREDITFLOW_GIT_URL>"
CREDITFLOW_BRANCH="<CREDITFLOW_RELEASE_BRANCH_OR_TAG>"

# MariaDB root bootstrap password consumed by the official compose.mariadb.yaml override.
# Bench generates the per-site database user password in private site_config.json.
DB_HOST="db"
DB_PORT=3306
DB_PASSWORD="<GENERATE_DATABASE_PASSWORD>"

# Initial site Administrator. Rotate after first login.
ADMIN_PASSWORD="<GENERATE_ADMINISTRATOR_PASSWORD>"

# Preserve this securely for encrypted Frappe Password fields and disaster recovery.
ENCRYPTION_KEY="<GENERATE_AND_STORE_ENCRYPTION_KEY>"

# Redis services provided by the official compose.redis.yaml override.
REDIS_CACHE="redis-cache:6379"
REDIS_QUEUE="redis-queue:6379"

# Optional outbound email settings; leave unset until a provider is selected.
MAIL_SERVER="<SMTP_HOST>"
MAIL_PORT="<SMTP_PORT>"
MAIL_LOGIN="<SMTP_USERNAME>"
MAIL_PASSWORD="<SMTP_PASSWORD>"
MAIL_USE_TLS="<0_OR_1>"

# Published ports for the HTTPS reverse proxy.
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
